# Copy to .env and fill in real values. Never commit .env.

API_HTTP_PORT=8080

# URL da API as seen by the browser (not the Docker internal hostname)
API_PUBLIC_BASE_URL=http://localhost:8080/

# Blazor WASM PWAs (nginx); must match Cors__AllowedOrigins on the API
BLAZOR_HTTP_PORT=8081
TUTOR_PORTAL_HTTP_PORT=8082
PLATFORM_HTTP_PORT=8083
CLINIC_SITE_HTTP_PORT=8084
Cors__AllowedOrigins__0=http://localhost:8081
Cors__AllowedOrigins__1=http://localhost:8082
Cors__AllowedOrigins__2=http://localhost:8083
Cors__AllowedOrigins__3=http://localhost:8084

# Redis (service in docker-compose.yml; not the application database)
REDIS_PASSWORD=CHANGE_ME_redis_password

# SQL Server — external managed instance or host (not included in compose)
ConnectionStrings__DefaultConnection=Server=your-sql-host,1433;Database=SysVet;User Id=app;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=False

# JWT (min. 16 characters)
JwtSettings__Secret=CHANGE_ME_jwt_secret_min_16_chars

# Distributed cache (ADR-057) — hostname must match the redis service name
Cache__Provider=Redis
Cache__ConnectionString=redis:6379,password=CHANGE_ME_redis_password,abortConnect=false

# Fiscal — override dev default in production (min. 32 characters)
Fiscal__CertificateEncryptionKey=CHANGE_ME_fiscal_cert_key_min_32_chars!!

# --- Optional integrations (leave empty or omit if unused) ---

Platform__Billing__ApiKey=
Platform__Billing__WebhookAccessToken=
Platform__Nfse__CertificateBlobKey=
Platform__Nfse__CertificatePassword=
BlobStorage__AzureConnectionString=
Automations__Smtp__Password=
Automations__Evolution__ApiKey=
Automations__NpsTokenSigningKey=
