@using SharedUI.Navigation

<div class="sidebar">
    <div class="sidebar-header">
        <h3>VetNexus</h3>
    </div>

    <nav class="nav flex-column">
        @foreach (var item in AppNavItems.All)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@item.Href" Match="@(item.Href == AppRoutes.Home ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                    <span class="bi @item.IconCss" aria-hidden="true"></span> @item.Label
                </NavLink>
            </div>
        }
    </nav>
</div>
