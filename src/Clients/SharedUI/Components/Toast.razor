@using SharedUI.Services
@implements IDisposable
@inject IToastService ToastService

<div class="toast-container">
    @foreach (var toast in ToastService.Toasts)
    {
        <div class="toast @toast.Type.ToString().ToLowerInvariant()">
            <div class="toast-message">@toast.Message</div>
            <button type="button" class="toast-close" aria-label="Fechar" @onclick="() => ToastService.Dismiss(toast.Id)">&times;</button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        ToastService.Changed += OnToastsChanged;
    }

    private void OnToastsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ToastService.Changed -= OnToastsChanged;
    }
}
