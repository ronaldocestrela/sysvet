@using SharedUI.Services
@implements IDisposable
@inject IConnectivityService ConnectivityService

@if (ConnectivityService.Status == ConnectivityStatus.Offline)
{
    <div class="connectivity-banner">
        Você está offline. Telas já visitadas podem abrir pelo cache do PWA; dados da API ficam indisponíveis até a conexão voltar.
    </div>
}

@code {
    protected override void OnInitialized()
    {
        ConnectivityService.StatusChanged += OnStatusChanged;
    }

    private void OnStatusChanged(object? sender, ConnectivityStatus status)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ConnectivityService.StatusChanged -= OnStatusChanged;
    }
}
