@typeparam TItem

<div class="data-grid-container">
    @if (Items == null)
    {
        <LoadingState IsLoading="true" Message="Carregando dados..." />
    }
    else if (!Items.Any())
    {
        <div class="empty-state">
            Nenhum registro encontrado.
        </div>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    @HeaderTemplate
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Items)
                {
                    <tr>
                        @RowTemplate(item)
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    /// <summary>Rows to display; null shows loading state.</summary>
    [Parameter] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>Table header cells.</summary>
    [Parameter] public RenderFragment? HeaderTemplate { get; set; }

    /// <summary>Template for each row's cells.</summary>
    [Parameter] public RenderFragment<TItem> RowTemplate { get; set; } = default!;
}
