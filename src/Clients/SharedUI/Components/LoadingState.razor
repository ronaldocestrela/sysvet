@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="spinner"></div>
        <p>@Message</p>
    </div>
}
else
{
    @ChildContent
}

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string Message { get; set; } = "Carregando...";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
