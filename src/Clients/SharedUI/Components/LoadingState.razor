@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="spinner"></div>
        <p>@Message</p>
    </div>
}
else
{
    @ChildContent
}

@code {
    /// <summary>When true, shows the loading overlay instead of child content.</summary>
    [Parameter] public bool IsLoading { get; set; }

    /// <summary>Loading message displayed under the spinner.</summary>
    [Parameter] public string Message { get; set; } = "Carregando...";

    /// <summary>Content rendered when not loading.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
