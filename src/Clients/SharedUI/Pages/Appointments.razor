@page "/appointments"
@using SharedUI.Components
@using SharedUI.Services
@using SharedUI.Navigation
@using Clients.Infrastructure.Crm
@inject IAppointmentStore AppointmentStore
@inject IPetStore PetStore
@inject IToastService Toast
@inject INavigationService Navigation

<div class="header-section">
    <h1>Agenda de Consultas</h1>
    <button class="btn btn-primary" @onclick="OpenAddModal">Agendar Novo</button>
</div>

<div class="calendar-container card">
    <div class="calendar-header">
        <button class="btn btn-sm" @onclick="PreviousDay">&lt; Anterior</button>
        <h3>@_currentDate.ToString("dd/MM/yyyy")</h3>
        <button class="btn btn-sm" @onclick="NextDay">Próximo &gt;</button>
    </div>

    <FormField Label="Veterinário (opcional)">
        <input type="text" class="form-control" @bind="_veterinarianFilter" placeholder="Guid do veterinário ou vazio para todos" />
        <button class="btn btn-sm mt-2" @onclick="LoadAppointmentsAsync">Filtrar</button>
    </FormField>

    <LoadingState IsLoading="_isLoading" Message="Carregando agenda...">
        <DayCalendar Items="_appointments"
                     OnConfirm="ConfirmAppointmentAsync"
                     OnStart="StartAppointmentAsync"
                     OnCancel="CancelAppointmentAsync"
                     OnOpenMedicalRecord="OpenMedicalRecordAsync" />
    </LoadingState>
</div>

<Modal @bind-IsVisible="_showModal" Title="Novo Agendamento">
    <ChildContent>
        <FormField Label="Pet">
            <select class="form-control" @bind="_selectedPetId">
                <option value="@Guid.Empty">Selecione...</option>
                @if (_pets is not null)
                {
                    @foreach (var pet in _pets)
                    {
                        <option value="@pet.Id">@pet.Name</option>
                    }
                }
            </select>
        </FormField>
        <FormField Label="Veterinário (ID)">
            <input type="text" class="form-control" @bind="_veterinarianIdInput" placeholder="Guid do Veterinário" />
        </FormField>
        <FormField Label="Data e Hora">
            <input type="datetime-local" class="form-control" @bind="_slotLocal" />
        </FormField>
        <FormField Label="Motivo">
            <input type="text" class="form-control" @bind="_reason" />
        </FormField>
    </ChildContent>
    <FooterTemplate>
        <button class="btn" @onclick="() => _showModal = false">Cancelar</button>
        <button class="btn btn-primary" @onclick="SaveAppointment">Agendar</button>
    </FooterTemplate>
</Modal>

@code {
    private DateTimeOffset _currentDate = DateTimeOffset.UtcNow.Date;
    private List<AppointmentListItemDto>? _appointments;
    private List<Clients.Infrastructure.Http.PetDto>? _pets;
    private bool _isLoading;
    private bool _showModal;
    private string _veterinarianFilter = string.Empty;
    private string _veterinarianIdInput = string.Empty;
    private Guid _selectedPetId;
    private DateTime _slotLocal = DateTime.UtcNow.AddDays(1);
    private string _reason = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadPetsAsync();
        await LoadAppointmentsAsync();
    }

    private async Task LoadPetsAsync()
    {
        var result = await PetStore.ListAsync(1, 200);
        if (result.IsSuccess)
        {
            _pets = result.Value.Items.ToList();
        }
    }

    private async Task LoadAppointmentsAsync()
    {
        _isLoading = true;
        Guid? vetId = Guid.TryParse(_veterinarianFilter, out var parsed) ? parsed : null;
        var result = await AppointmentStore.GetDailyAsync(vetId, _currentDate);
        _appointments = result.IsSuccess ? result.Value : [];
        _isLoading = false;
    }

    private async Task PreviousDay()
    {
        _currentDate = _currentDate.AddDays(-1);
        await LoadAppointmentsAsync();
    }

    private async Task NextDay()
    {
        _currentDate = _currentDate.AddDays(1);
        await LoadAppointmentsAsync();
    }

    private void OpenAddModal()
    {
        _slotLocal = _currentDate.UtcDateTime.AddHours(9);
        _showModal = true;
    }

    private async Task SaveAppointment()
    {
        if (_selectedPetId == Guid.Empty || !Guid.TryParse(_veterinarianIdInput, out var vetId))
        {
            Toast.Show("Selecione pet e veterinário válidos.", ToastType.Error);
            return;
        }

        var pet = _pets?.FirstOrDefault(p => p.Id == _selectedPetId);
        if (pet is null)
        {
            Toast.Show("Pet não encontrado.", ToastType.Error);
            return;
        }

        var slot = new DateTimeOffset(DateTime.SpecifyKind(_slotLocal, DateTimeKind.Utc));
        var request = new ScheduleAppointmentRequest
        {
            TutorId = pet.TutorId,
            PetId = pet.Id,
            VeterinarianId = vetId,
            Date = slot,
            DurationInMinutes = 30,
            Reason = _reason
        };

        var result = await AppointmentStore.ScheduleAsync(request);
        if (result.IsSuccess)
        {
            Toast.Show("Consulta agendada.", ToastType.Success);
            _showModal = false;
            await LoadAppointmentsAsync();
        }
        else
        {
            Toast.Show(result.Error.Message, ToastType.Error);
        }
    }

    private async Task ConfirmAppointmentAsync(Guid id)
    {
        var result = await AppointmentStore.ConfirmAsync(id);
        if (result.IsSuccess)
        {
            await LoadAppointmentsAsync();
        }
        else
        {
            Toast.Show(result.Error.Message, ToastType.Error);
        }
    }

    private async Task StartAppointmentAsync(Guid id)
    {
        var result = await AppointmentStore.StartAsync(id);
        if (result.IsSuccess)
        {
            await LoadAppointmentsAsync();
        }
        else
        {
            Toast.Show(result.Error.Message, ToastType.Error);
        }
    }

    private async Task CancelAppointmentAsync(Guid id)
    {
        var result = await AppointmentStore.CancelAsync(id);
        if (result.IsSuccess)
        {
            await LoadAppointmentsAsync();
        }
        else
        {
            Toast.Show(result.Error.Message, ToastType.Error);
        }
    }

    private Task OpenMedicalRecordAsync(AppointmentListItemDto appointment)
    {
        Navigation.NavigateTo(AppRoutes.PetMedicalRecords(appointment.PetId, appointment.Id));
        return Task.CompletedTask;
    }
}
