@page "/hospitalizations"
@using SharedUI.Components
@using SharedUI.Navigation
@using SharedUI.Services
@using Clients.Infrastructure.Crm
@inject IHospitalizationStore HospitalizationStore
@inject INavigationService Navigation
@inject IToastService Toast

<div class="header-section no-print">
    <h1>Mapa de execução</h1>
    <div class="header-actions">
        <button class="btn btn-sm btn-outline" @onclick="() => Navigation.NavigateTo(AppRoutes.HospitalizationUnits)">Recintos</button>
        <input type="date" class="form-control date-filter" @bind="_mapDate" @bind:after="LoadMapAsync" />
    </div>
</div>

<LoadingState IsLoading="_loading" Message="Carregando mapa...">
    @if (_map is null || _map.Wards.Count == 0)
    {
        <div class="empty-state">Nenhuma unidade/leito configurado ou sem internações.</div>
    }
    else
    {
        @foreach (var ward in _map.Wards)
        {
            <h2 class="ward-title">@ward.WardName</h2>
            <div class="hospitalizations-grid">
                @foreach (var bed in ward.Beds)
                {
                    <div class="hosp-card @(bed.HospitalizationId.HasValue ? "occupied" : "vacant")">
                        <div class="hosp-header">
                            <h3>Leito @bed.BedCode</h3>
                            @if (bed.HospitalizationId.HasValue)
                            {
                                <span class="badge badge-warning">@bed.PetName</span>
                            }
                            else
                            {
                                <span class="badge badge-muted">Vago</span>
                            }
                        </div>
                        @if (bed.HospitalizationId.HasValue)
                        {
                            <div class="admin-list">
                                @if (bed.Administrations.Count == 0)
                                {
                                    <p class="muted">Sem prescrições para @_map.Date.ToString("dd/MM/yyyy").</p>
                                }
                                @foreach (var admin in bed.Administrations)
                                {
                                    <div class="admin-row">
                                        <div>
                                            <strong>@admin.MedicationName</strong> @admin.Dose
                                            <div class="muted">@admin.ScheduledAt.ToLocalTime().ToString("HH:mm") · @DisplayStatus(admin.Status)</div>
                                        </div>
                                        @if (admin.Status == "Pending")
                                        {
                                            <button class="btn btn-sm btn-primary" @onclick="() => Administer(bed.HospitalizationId!.Value, admin.Id)">Aplicar</button>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="hosp-actions">
                                <button class="btn btn-sm btn-outline" @onclick="() => Navigation.NavigateTo(AppRoutes.HospitalizationDetail(bed.HospitalizationId!.Value))">Detalhe</button>
                                <button class="btn btn-sm btn-outline" @onclick="() => Discharge(bed.HospitalizationId!.Value)">Alta</button>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</LoadingState>

<style>
    .header-section { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--spacing-lg); gap: var(--spacing-md); }
    .header-actions { display: flex; align-items: center; gap: var(--spacing-sm); }
    .date-filter { max-width: 180px; }
    .ward-title { margin: var(--spacing-lg) 0 var(--spacing-sm); font-size: 1.1rem; }
    .admin-list { margin: 10px 0; display: flex; flex-direction: column; gap: 8px; }
    .admin-row { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 0.9rem; }
    .muted { color: var(--color-text-muted, #666); font-size: 0.85rem; }
    .badge-muted { background: #e5e7eb; color: #374151; padding: 4px 8px; border-radius: 12px; font-size: 0.75rem; }
    .hosp-card.vacant { border-top-color: var(--color-border, #ccc); opacity: 0.85; }
</style>

@code {
    private ExecutionMapViewModel? _map;
    private bool _loading = true;
    private DateTime _mapDate = DateTime.UtcNow.Date;

    protected override async Task OnInitializedAsync() => await LoadMapAsync();

    private async Task LoadMapAsync()
    {
        _loading = true;
        var day = DateOnly.FromDateTime(_mapDate.ToUniversalTime());
        var result = await HospitalizationStore.GetExecutionMapAsync(day);
        _map = result.IsSuccess ? result.Value : null;
        if (result.IsFailure)
        {
            Toast.Show(result.Error.Message, ToastType.Error);
        }

        _loading = false;
    }

    private static string DisplayStatus(string status) => status switch
    {
        "Administered" => "Aplicada",
        "Skipped" => "Pulada",
        "Cancelled" => "Cancelada",
        _ => "Pendente"
    };

    private async Task Administer(Guid hospId, Guid adminId)
    {
        var result = await HospitalizationStore.AdministerAsync(hospId, adminId, null);
        if (result.IsFailure)
        {
            Toast.Show(result.Error.Message, ToastType.Error);
            return;
        }

        Toast.Show("Medicação registrada.", ToastType.Success);
        await LoadMapAsync();
    }

    private async Task Discharge(Guid hospId)
    {
        var result = await HospitalizationStore.DischargeAsync(hospId);
        if (result.IsFailure)
        {
            Toast.Show(result.Error.Message, ToastType.Error);
            return;
        }

        Toast.Show("Alta registrada.", ToastType.Success);
        await LoadMapAsync();
    }
}
