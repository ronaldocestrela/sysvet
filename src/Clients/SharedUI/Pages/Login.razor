@page "/login"
@layout AuthLayout
@using SharedUI.Components
@using SharedUI.Layout
@using SharedUI.Services
@using SharedUI.Navigation
@using System.ComponentModel.DataAnnotations
@using Clients.Infrastructure.Http
@inject IAuthState AuthState
@inject INavigationService Navigation
@inject ApiClient ApiClient

<div class="login-page">
    <div class="login-card">
        <h2 class="text-center">VetNexus</h2>
        <p class="text-center text-muted mb-4">Faça login para acessar o sistema.</p>

        <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <FormField Label="E-mail" Error="@_errorMsg">
                <InputText @bind-Value="_loginModel.Email" type="email" placeholder="seu@email.com" class="form-control" />
            </FormField>

            <FormField Label="Senha">
                <InputText @bind-Value="_loginModel.Password" type="password" placeholder="Sua senha" class="form-control" />
            </FormField>

            <LoadingState IsLoading="_isLoading" Message="Autenticando...">
                <button type="submit" class="btn btn-primary w-100 mt-3">Entrar</button>
            </LoadingState>
        </EditForm>
    </div>
</div>

@code {
    private LoginModel _loginModel = new();
    private bool _isLoading;
    private string _errorMsg = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo(AppRoutes.Home);
        }
    }

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMsg = string.Empty;
        StateHasChanged();

        try
        {
            var loginResult = await ApiClient.PostAsync<LoginRequest, AuthTokensDto>(
                "/api/v1/auth/login",
                new LoginRequest { Email = _loginModel.Email, Password = _loginModel.Password });

            if (loginResult.IsFailure)
            {
                _errorMsg = loginResult.Error.Message;
                return;
            }

            await AuthState.LoginAsync(loginResult.Value.AccessToken, loginResult.Value.RefreshToken);

            var meResult = await ApiClient.GetAsync<CurrentUserDto>("/api/v1/auth/me");
            if (meResult.IsSuccess)
            {
                await AuthState.SetMenusAsync(meResult.Value.Menus);
            }

            Navigation.NavigateTo(AppRoutes.Home);
        }
        catch (Exception ex)
        {
            _errorMsg = $"Erro ao tentar fazer login: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private class LoginModel
    {
        [Required(ErrorMessage = "O E-mail é obrigatório.")]
        [EmailAddress(ErrorMessage = "Formato de E-mail inválido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "A senha é obrigatória.")]
        public string Password { get; set; } = string.Empty;
    }
}

<style>
    .login-page {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        background-color: var(--color-bg);
    }
    
    .login-card {
        background: var(--color-surface);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-lg);
        padding: var(--spacing-xl);
        width: 100%;
        max-width: 400px;
    }

    .text-center { text-align: center; }
    .text-muted { color: var(--color-text-muted); }
    .mb-4 { margin-bottom: var(--spacing-xl); }
    .mt-3 { margin-top: var(--spacing-lg); }
    .w-100 { width: 100%; }
</style>
