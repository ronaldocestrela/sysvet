@page "/pets/{petId:guid}/medical-records"
@using SharedUI.Components
@using SharedUI.Navigation
@using Clients.Infrastructure.Crm
@using Microsoft.AspNetCore.Components.Forms
@inject IMedicalRecordStore MedicalRecordStore
@inject IClinicalStore ClinicalStore
@inject IClinicalAttachmentService? AttachmentService
@inject INavigationService Navigation
@inject IToastService Toast

<div class="header-section">
    <h1>Prontuário Médico</h1>
    <div class="header-actions">
        <button class="btn btn-outline" @onclick="GoBack">Voltar</button>
        @if (_selected is not null && _selected.Status == "Draft")
        {
            <button class="btn btn-primary" @onclick="FinalizeAsync">Finalizar atendimento</button>
        }
    </div>
</div>

<div class="records-layout">
    <div class="records-timeline card">
        <LoadingState IsLoading="_isLoading" Message="Carregando histórico do paciente...">
            @if (_timeline is null || _timeline.Count == 0)
            {
                <div class="empty-state">Nenhum registro encontrado para este pet.</div>
            }
            else
            {
                @foreach (var item in _timeline)
                {
                    <button type="button" class="timeline-item @(item.Id == _selectedId ? "active" : "")" @onclick="() => SelectRecordAsync(item.Id)">
                        <div class="record-header">
                            <h4>@item.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</h4>
                            <span class="badge @item.Status.ToLower()">@item.Status</span>
                        </div>
                        <p class="preview">@item.DiagnosisPreview</p>
                    </button>
                }
            }
        </LoadingState>
    </div>

    @if (_selected is not null)
    {
        <div class="record-detail card">
            <h3>Detalhe do atendimento</h3>
            <FormField Label="Anamnese">
                <textarea class="form-control" rows="3" @bind="_selectedAnamnesis" disabled="@(_selected.Status != "Draft")"></textarea>
            </FormField>
            <FormField Label="Diagnóstico">
                <textarea class="form-control" rows="2" @bind="_selectedDiagnosis" disabled="@(_selected.Status != "Draft")"></textarea>
            </FormField>
            <FormField Label="Conduta">
                <textarea class="form-control" rows="2" @bind="_selectedConduct" disabled="@(_selected.Status != "Draft")"></textarea>
            </FormField>

            @if (_selected.Status == "Draft")
            {
                <button class="btn btn-primary mt-2" @onclick="SaveDraftAsync">Salvar rascunho</button>
                <hr />
                <FormField Label="Nova evolução">
                    <textarea class="form-control" rows="2" @bind="_newEvolution"></textarea>
                </FormField>
                <button class="btn btn-outline mt-2" @onclick="AddEvolutionAsync">Adicionar evolução</button>
            }

            @if (_selected.EvolutionNotes.Count > 0)
            {
                <h4 class="mt-3">Evoluções</h4>
                <ul>
                    @foreach (var note in _selected.EvolutionNotes.OrderByDescending(n => n.RecordedAt))
                    {
                        <li><small>@note.RecordedAt.ToLocalTime():</small> @note.Text</li>
                    }
                </ul>
            }

            <hr />
            <h4>Exames clínicos</h4>
            <div class="d-flex gap-2 mb-2">
                <input class="form-control" @bind="_newExamName" placeholder="Nome do exame" disabled="@(_selected.Status != "Draft")" />
                <select class="form-control" @bind="_newExamCategory" disabled="@(_selected.Status != "Draft")">
                    <option value="Laboratory">Laboratorial</option>
                    <option value="Imaging">Imagem</option>
                    <option value="Procedure">Procedimento</option>
                    <option value="Other">Outro</option>
                </select>
                @if (_selected.Status == "Draft")
                {
                    <button class="btn btn-outline" @onclick="RequestExamAsync">Solicitar</button>
                }
            </div>
            @if (_exams?.Count > 0)
            {
                <ul>
                    @foreach (var exam in _exams)
                    {
                        <li>@exam.Name — @exam.Status @(!string.IsNullOrEmpty(exam.ResultSummary) ? $"({exam.ResultSummary})" : "")</li>
                    }
                </ul>
            }

            <h4 class="mt-3">Receitas emitidas</h4>
            @if (_prescriptions?.Count > 0)
            {
                <ul>
                    @foreach (var rx in _prescriptions)
                    {
                        <li>Receita @rx.Id.ToString()[..8] — @rx.Status (@rx.ItemCount itens)</li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted">Nenhuma receita formal sincronizada para este atendimento.</p>
            }

            <h4 class="mt-3">Anexos</h4>
            @if (_selected.Status == "Draft" && AttachmentService is not null)
            {
                <InputFile OnChange="UploadAttachmentAsync" />
            }
            else if (AttachmentService is null)
            {
                <p class="text-muted">Upload de anexos disponível apenas com conexão à API.</p>
            }
            @if (_attachments?.Count > 0)
            {
                <ul>
                    @foreach (var file in _attachments)
                    {
                        <li>
                            @file.FileName (@file.Kind, @file.SizeBytes bytes)
                            @if (AttachmentService is not null)
                            {
                                <a href="@($"/api/v1/attachments/{file.Id}/content")" target="_blank" rel="noopener">Download</a>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid PetId { get; set; }

    [SupplyParameterFromQuery(Name = "appointmentId")]
    public Guid? AppointmentId { get; set; }

    private IReadOnlyList<MedicalRecordTimelineItemDto>? _timeline;
    private MedicalRecordDetailDto? _selected;
    private Guid? _selectedId;
    private bool _isLoading;
    private string _selectedAnamnesis = string.Empty;
    private string _selectedDiagnosis = string.Empty;
    private string _selectedConduct = string.Empty;
    private string _newEvolution = string.Empty;
    private string _newExamName = string.Empty;
    private string _newExamCategory = "Laboratory";
    private IReadOnlyList<ClinicalExamListItemDto>? _exams;
    private IReadOnlyList<IssuedPrescriptionListItemDto>? _prescriptions;
    private IReadOnlyList<ClinicalAttachmentListItemDto>? _attachments;

    protected override async Task OnInitializedAsync()
    {
        if (AppointmentId is Guid appointmentId)
        {
            var create = await MedicalRecordStore.GetOrCreateByAppointmentAsync(appointmentId);
            if (create.IsFailure)
            {
                Toast.Show(create.Error.Message, ToastType.Error);
            }
        }

        await LoadTimelineAsync();
    }

    private async Task LoadTimelineAsync()
    {
        _isLoading = true;
        var result = await MedicalRecordStore.GetTimelineByPetAsync(PetId);
        _timeline = result.IsSuccess ? result.Value : Array.Empty<MedicalRecordTimelineItemDto>();
        _isLoading = false;

        if (AppointmentId is Guid appointmentId && _timeline is not null)
        {
            var match = _timeline.FirstOrDefault(t => t.AppointmentId == appointmentId);
            if (match is not null)
            {
                await SelectRecordAsync(match.Id);
            }
        }
        else if (_timeline?.Count > 0 && _selectedId is null)
        {
            await SelectRecordAsync(_timeline[0].Id);
        }
    }

    private async Task SelectRecordAsync(Guid id)
    {
        var result = await MedicalRecordStore.GetByIdAsync(id);
        if (result.IsFailure)
        {
            Toast.Show(result.Error.Message, ToastType.Error);
            return;
        }

        _selectedId = id;
        _selected = result.Value;
        _selectedAnamnesis = _selected.Anamnesis;
        _selectedDiagnosis = _selected.Diagnosis;
        _selectedConduct = _selected.Conduct;
        await LoadClinicalArtifactsAsync(_selected.AppointmentId);
    }

    private async Task LoadClinicalArtifactsAsync(Guid appointmentId)
    {
        var exams = await ClinicalStore.GetExamsByAppointmentAsync(appointmentId);
        _exams = exams.IsSuccess ? exams.Value : Array.Empty<ClinicalExamListItemDto>();
        var prescriptions = await ClinicalStore.GetPrescriptionsByAppointmentAsync(appointmentId);
        _prescriptions = prescriptions.IsSuccess ? prescriptions.Value : Array.Empty<IssuedPrescriptionListItemDto>();
        var attachments = await ClinicalStore.GetAttachmentsByAppointmentAsync(appointmentId);
        _attachments = attachments.IsSuccess ? attachments.Value : Array.Empty<ClinicalAttachmentListItemDto>();
    }

    private async Task RequestExamAsync()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_newExamName))
        {
            return;
        }

        var result = await ClinicalStore.RequestExamAsync(_selected.AppointmentId, _newExamName, _newExamCategory);
        if (result.IsFailure)
        {
            Toast.Show(result.Error.Message, ToastType.Error);
            return;
        }

        _newExamName = string.Empty;
        Toast.Show("Exame solicitado.", ToastType.Success);
        await LoadClinicalArtifactsAsync(_selected.AppointmentId);
    }

    private async Task UploadAttachmentAsync(InputFileChangeEventArgs args)
    {
        if (_selected is null || AttachmentService is null || args.File is null)
        {
            Toast.Show("Conecte-se para enviar anexos.", ToastType.Warning);
            return;
        }

        await using var stream = args.File.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
        var result = await AttachmentService.UploadAsync(_selected.AppointmentId, stream, args.File.Name, args.File.ContentType);
        if (result.IsFailure)
        {
            Toast.Show(result.Error.Message, ToastType.Error);
            return;
        }

        Toast.Show("Anexo enviado.", ToastType.Success);
        await LoadClinicalArtifactsAsync(_selected.AppointmentId);
    }

    private async Task SaveDraftAsync()
    {
        if (_selected is null)
        {
            return;
        }

        var anamnesis = await MedicalRecordStore.UpdateAnamnesisAsync(_selected.Id, _selectedAnamnesis);
        var diagnosis = await MedicalRecordStore.SetDiagnosisAsync(_selected.Id, _selectedDiagnosis);
        var conduct = await MedicalRecordStore.SetConductAsync(_selected.Id, _selectedConduct);

        if (anamnesis.IsFailure || diagnosis.IsFailure || conduct.IsFailure)
        {
            Toast.Show("Falha ao salvar rascunho.", ToastType.Error);
            return;
        }

        Toast.Show("Rascunho salvo.", ToastType.Success);
        await LoadTimelineAsync();
        await SelectRecordAsync(_selected.Id);
    }

    private async Task AddEvolutionAsync()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_newEvolution))
        {
            return;
        }

        var result = await MedicalRecordStore.AddEvolutionNoteAsync(_selected.Id, _newEvolution);
        if (result.IsFailure)
        {
            Toast.Show(result.Error.Message, ToastType.Error);
            return;
        }

        _newEvolution = string.Empty;
        await SelectRecordAsync(_selected.Id);
    }

    private async Task FinalizeAsync()
    {
        if (_selected is null)
        {
            return;
        }

        var result = await MedicalRecordStore.FinalizeAsync(_selected.Id);
        if (result.IsFailure)
        {
            Toast.Show(result.Error.Message, ToastType.Error);
            return;
        }

        Toast.Show("Prontuário finalizado.", ToastType.Success);
        await LoadTimelineAsync();
        await SelectRecordAsync(_selected.Id);
    }

    private void GoBack() => Navigation.NavigateTo(AppRoutes.Pets);
}
