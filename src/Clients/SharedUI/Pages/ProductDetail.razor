@page "/products/{ProductId:guid}"
@using Clients.Infrastructure.Crm
@using Clients.Infrastructure.Http
@using SharedUI.Components
@using SharedUI.Services
@inject IInventoryStore InventoryStore
@inject IProductLabelApiService LabelApi
@inject IFileDownloadService FileDownload
@inject IToastService Toast

@if (_loading)
{
    <LoadingState Message="Carregando produto..." />
}
else if (_product is null)
{
    <p class="empty-state">Produto não encontrado.</p>
}
else
{
    <div class="header-section">
        <h1>@_product.Name</h1>
        <p>SKU: @_product.Sku | Barras: @_product.Barcode | Ponto pedido: @_product.ReorderLevel | Estoque alvo: @_product.TargetStock | Saldo total: @_product.TotalQuantity (lacrado: @_product.SealedQuantity, fracionado: @_product.FractionalQuantity) | Unid./embalagem: @_product.UnitsPerPackage | Custo médio: @_product.AverageCost.ToString("N2")</p>
    </div>

    <div class="card p-3 mb-3">
        <h2>Etiqueta</h2>
        <div class="label-actions">
            <FormField Label="Formato">
                <select @bind="_labelFormat">
                    <option value="pdf">PDF</option>
                    <option value="zpl">ZPL</option>
                </select>
            </FormField>
            <FormField Label="Cópias"><input type="number" min="1" max="50" @bind="_labelCopies" /></FormField>
            <button class="btn btn-primary" @onclick="DownloadLabelAsync">Gerar etiqueta</button>
        </div>
    </div>

    <div class="card p-3">
        <div class="header-section">
            <h2>Lotes</h2>
            <button class="btn btn-primary" @onclick="() => _showLotModal = true">Novo lote</button>
        </div>
        @if (!_product.Lots.Any())
        {
            <p class="empty-state">Nenhum lote cadastrado.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Lote</th>
                        <th>Validade</th>
                        <th>Custo unit.</th>
                        <th>Quantidade</th>
                        <th>Tipo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lot in _product.Lots)
                    {
                        <tr>
                            <td>@lot.LotNumber</td>
                            <td>@(lot.ExpirationDate?.ToString("d") ?? "—")</td>
                            <td>@lot.UnitCost.ToString("N2")</td>
                            <td>@lot.Quantity</td>
                            <td>@(lot.IsFractional ? "Fracionado" : "Lacrado")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="card p-3 mt-3">
        <h2>Kardex</h2>
        @if (!_kardex.Any())
        {
            <p class="empty-state">Sem movimentações registradas.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Tipo</th>
                        <th>Qtd</th>
                        <th>Saldo</th>
                        <th>Motivo</th>
                        <th>Lote</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in _kardex)
                    {
                        <tr>
                            <td>@line.Date.LocalDateTime.ToString("g")</td>
                            <td>@line.Type</td>
                            <td>@line.Quantity</td>
                            <td>@line.RunningBalance</td>
                            <td>@line.Reason</td>
                            <td>@(line.LotNumber ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

<Modal @bind-IsVisible="_showLotModal" Title="Novo lote">
    <ChildContent>
        <FormField Label="Número do lote"><input type="text" @bind="_lotNumber" /></FormField>
        <FormField Label="Validade"><input type="date" @bind="_expirationDate" /></FormField>
        <FormField Label="Custo unitário"><input type="number" step="0.01" @bind="_unitCost" /></FormField>
        <FormField Label="Quantidade inicial"><input type="number" step="0.01" @bind="_initialQty" /></FormField>
    </ChildContent>
    <FooterTemplate>
        <button class="btn" @onclick="() => _showLotModal = false">Cancelar</button>
        <button class="btn btn-primary" @onclick="SaveLot">Salvar</button>
    </FooterTemplate>
</Modal>

<style>
    .header-section { margin-bottom: var(--spacing-md); }
    .label-actions { display: flex; flex-wrap: wrap; gap: var(--spacing-md); align-items: flex-end; }
</style>

@code {
    [Parameter] public Guid ProductId { get; set; }

    private InventoryProductDetail? _product;
    private List<InventoryKardexLine> _kardex = [];
    private bool _loading = true;
    private bool _showLotModal;
    private string _lotNumber = "";
    private DateTime? _expirationDate;
    private decimal _unitCost;
    private decimal _initialQty;
    private string _labelFormat = "pdf";
    private int _labelCopies = 1;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await InventoryStore.GetProductByIdAsync(ProductId);
        _product = result.IsSuccess ? result.Value : null;
        var kardex = await InventoryStore.GetProductKardexAsync(ProductId);
        _kardex = kardex.IsSuccess ? kardex.Value.ToList() : [];
        _loading = false;
    }

    private async Task SaveLot()
    {
        DateTimeOffset? exp = _expirationDate.HasValue
            ? new DateTimeOffset(_expirationDate.Value.ToUniversalTime())
            : null;
        await InventoryStore.RegisterProductLotAsync(ProductId, _lotNumber, exp, _unitCost, _initialQty);
        _showLotModal = false;
        await LoadAsync();
    }

    private async Task DownloadLabelAsync()
    {
        var result = await LabelApi.DownloadProductLabelAsync(ProductId, _labelFormat, _labelCopies);
        if (result.IsFailure)
        {
            Toast.Show(result.Error.Message, ToastType.Error);
            return;
        }

        await FileDownload.DownloadAsync(result.Value.FileName, result.Value.ContentType, result.Value.Content);
    }
}
