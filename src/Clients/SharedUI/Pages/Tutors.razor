@page "/tutors"
@using SharedUI.Components
@using SharedUI.Services
@using Clients.Infrastructure.Automations
@using Clients.Infrastructure.Http
@using Clients.Infrastructure.Crm
@inject ITutorStore TutorStore
@inject AutomationsApiService AutomationsApi
@inject IConnectivityService Connectivity
@inject IToastService Toast

<div class="header-section">
    <h1>Tutores</h1>
    <button class="btn btn-primary" @onclick="OpenAddModal">Novo Tutor</button>
</div>

<div class="card">
    <LoadingState IsLoading="_isLoading" Message="Carregando tutores...">
        <DataGrid Items="_tutors">
            <HeaderTemplate>
                <th>Nome</th>
                <th>Email</th>
                <th>Telefone</th>
                <th>Ações</th>
            </HeaderTemplate>
            <RowTemplate Context="tutor">
                <td>@tutor.Name</td>
                <td>@tutor.Email</td>
                <td>@tutor.Phone</td>
                <td>
                    <button class="btn btn-sm btn-info" @onclick="async () => await EditTutor(tutor)">Editar</button>
                </td>
            </RowTemplate>
        </DataGrid>
    </LoadingState>
</div>

<Modal @bind-IsVisible="_showModal" Title="@(_editingTutor == null ? "Novo Tutor" : "Editar Tutor")">
    <ChildContent>
        <FormField Label="Nome">
            <input type="text" @bind="_currentTutor.Name" class="form-control" />
        </FormField>
        <FormField Label="E-mail">
            <input type="email" @bind="_currentTutor.Email" class="form-control" />
        </FormField>
        <FormField Label="CPF">
            <input type="text" @bind="_currentTutor.Cpf" class="form-control" disabled="@(_editingTutor != null)" />
        </FormField>
        <FormField Label="Telefone">
            <input type="tel" @bind="_currentTutor.Phone" class="form-control" />
        </FormField>
        @if (_editingTutor is not null && Connectivity.IsOnline)
        {
            <hr class="my-3" />
            <p class="small text-muted mb-2">Lembretes transacionais (vacina, consulta, retorno). SMS não disponível.</p>
            <FormField Label="WhatsApp">
                <input type="checkbox" @bind="_whatsAppEnabled" class="form-check-input" id="tutor-pref-wa" />
            </FormField>
            <FormField Label="E-mail">
                <input type="checkbox" @bind="_emailEnabled" class="form-check-input" id="tutor-pref-email" />
            </FormField>
        }
        else if (_editingTutor is not null && !Connectivity.IsOnline)
        {
            <p class="small text-muted mt-2 mb-0">Preferências de lembrete só podem ser alteradas online.</p>
        }
    </ChildContent>
    <FooterTemplate>
        <button class="btn" @onclick="CloseModal">Cancelar</button>
        <button class="btn btn-primary" @onclick="SaveTutor">Salvar</button>
    </FooterTemplate>
</Modal>

@code {
    private List<TutorDto>? _tutors;
    private bool _showModal;
    private bool _isLoading;
    private TutorDto? _editingTutor;
    private TutorDto _currentTutor = new();
    private bool _whatsAppEnabled = true;
    private bool _emailEnabled = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadTutorsAsync();
    }

    private async Task LoadTutorsAsync()
    {
        _isLoading = true;
        try
        {
            var result = await TutorStore.ListAsync(1, 100);
            if (result.IsSuccess)
            {
                _tutors = result.Value.Items.ToList();
            }
            else
            {
                _tutors = [];
                Toast.Show(result.Error.Message, ToastType.Error);
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        _editingTutor = null;
        _currentTutor = new TutorDto();
        _showModal = true;
    }

    private async Task EditTutor(TutorDto tutor)
    {
        _editingTutor = tutor;
        _currentTutor = new TutorDto
        {
            Id = tutor.Id,
            Name = tutor.Name,
            Email = tutor.Email,
            Cpf = tutor.Cpf,
            Phone = tutor.Phone
        };
        _whatsAppEnabled = true;
        _emailEnabled = true;
        if (Connectivity.IsOnline)
        {
            var prefResult = await AutomationsApi.GetTutorPreferencesAsync(tutor.Id);
            if (prefResult.IsSuccess)
            {
                _whatsAppEnabled = prefResult.Value.WhatsAppEnabled;
                _emailEnabled = prefResult.Value.EmailEnabled;
            }
        }

        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
    }

    private async Task SaveTutor()
    {
        if (_editingTutor is null)
        {
            var id = Guid.NewGuid();
            var result = await TutorStore.CreateAsync(new CreateTutorRequest
            {
                Id = id,
                Name = _currentTutor.Name,
                Email = _currentTutor.Email,
                Cpf = _currentTutor.Cpf,
                Phone = _currentTutor.Phone
            });

            if (result.IsFailure)
            {
                Toast.Show(result.Error.Message, ToastType.Error);
                return;
            }
        }
        else
        {
            var result = await TutorStore.UpdateAsync(new UpdateTutorRequest
            {
                Id = _currentTutor.Id,
                Name = _currentTutor.Name,
                Email = _currentTutor.Email,
                Phone = _currentTutor.Phone
            });

            if (result.IsFailure)
            {
                Toast.Show(result.Error.Message, ToastType.Error);
                return;
            }

            if (Connectivity.IsOnline)
            {
                var prefResult = await AutomationsApi.UpdateTutorPreferencesAsync(
                    _currentTutor.Id,
                    new TutorMessagingPreferenceClientDto
                    {
                        TutorId = _currentTutor.Id,
                        WhatsAppEnabled = _whatsAppEnabled,
                        EmailEnabled = _emailEnabled
                    });
                if (prefResult.IsFailure)
                {
                    Toast.Show(prefResult.Error.Message, ToastType.Error);
                    return;
                }
            }
        }

        _showModal = false;
        Toast.Show("Tutor salvo com sucesso.", ToastType.Success);
        await LoadTutorsAsync();
    }
}
