@page "/pets/{petId:guid}/quotes/{quoteId:guid}"
@using Microsoft.JSInterop
@using SharedUI.Components
@using Clients.Infrastructure.Crm
@inject IClinicalQuoteStore QuoteStore
@inject IToastService Toast
@inject IJSRuntime Js

<div class="header-section no-print">
    <h1>Orçamento clínico</h1>
    <button class="btn btn-outline" @onclick="PrintAsync">Imprimir / PDF</button>
</div>

<LoadingState IsLoading="_loading" Message="Carregando orçamento...">
    @if (_quote is not null)
    {
        <div class="card print-area">
            <p><strong>Status:</strong> @_quote.Status</p>
            @if (!string.IsNullOrWhiteSpace(_quote.Notes))
            {
                <p>@_quote.Notes</p>
            }
            <table class="data-table">
                <thead>
                    <tr><th>Descrição</th><th>Qtd</th><th>Unit.</th><th>Total</th></tr>
                </thead>
                <tbody>
                    @foreach (var line in _quote.Items)
                    {
                        <tr>
                            <td>@line.Description</td>
                            <td>@line.Quantity</td>
                            <td>@line.UnitPrice.ToString("C")</td>
                            <td>@((line.Quantity * line.UnitPrice).ToString("C"))</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p><strong>Total:</strong> @_quote.TotalAmount.ToString("C")</p>
        </div>
    }
</LoadingState>

<style>
    .header-section { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--spacing-lg); }
    .data-table { width: 100%; border-collapse: collapse; }
    .data-table th, .data-table td { border: 1px solid var(--color-border); padding: var(--spacing-sm); text-align: left; }
    @@media print {
        .no-print { display: none !important; }
        .print-area { box-shadow: none; border: none; }
    }
</style>

@code {
    [Parameter] public Guid PetId { get; set; }
    [Parameter] public Guid QuoteId { get; set; }

    private ClinicalQuoteDetailDto? _quote;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var result = await QuoteStore.GetByIdAsync(QuoteId);
        if (result.IsFailure)
        {
            Toast.Show(result.Error.Message, ToastType.Error);
        }
        else if (result.Value.PetId != PetId)
        {
            Toast.Show("Orçamento não pertence a este pet.", ToastType.Error);
        }
        else
        {
            _quote = result.Value;
        }

        _loading = false;
    }

    private async Task PrintAsync() => await Js.InvokeVoidAsync("print");
}
