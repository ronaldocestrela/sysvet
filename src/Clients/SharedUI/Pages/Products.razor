@page "/products"
@using Clients.Infrastructure.Crm
@using Inventory.Domain.Enums
@using SharedUI.Components
@using SharedUI.Navigation
@inject IInventoryStore InventoryStore
@inject INavigationService Navigation

<div class="header-section">
    <h1>Catálogo de Produtos</h1>
    <button class="btn btn-primary" @onclick="OpenAddModal">Novo Produto</button>
</div>

<div class="card p-3">
    @if (_isLoading)
    {
        <LoadingState Message="Carregando produtos..." />
    }
    else if (_products == null || !_products.Any())
    {
        <p class="empty-state">Nenhum produto cadastrado.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>SKU</th>
                    <th>Código de Barras</th>
                    <th>Estoque</th>
                    <th>Custo médio</th>
                    <th>NCM</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prod in _products)
                {
                    <tr class="@(prod.TotalQuantity <= prod.ReorderLevel ? "low-stock" : "")">
                        <td><strong>@prod.Name</strong></td>
                        <td>@prod.Sku</td>
                        <td>@prod.Barcode</td>
                        <td>@prod.TotalQuantity</td>
                        <td>@prod.AverageCost.ToString("N2")</td>
                        <td>—</td>
                        <td>
                            <button class="btn btn-sm btn-outline" @onclick="() => GoToDetail(prod.Id)">Detalhes</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<Modal @bind-IsVisible="_showModal" Title="Novo Produto">
    <ChildContent>
        <FormField Label="Nome"><input type="text" @bind="_name" /></FormField>
        <FormField Label="Descrição"><input type="text" @bind="_description" /></FormField>
        <FormField Label="SKU"><input type="text" @bind="_sku" /></FormField>
        <FormField Label="Código de Barras"><input type="text" @bind="_barcode" /></FormField>
        <FormField Label="NCM (8 dígitos)"><input type="text" @bind="_ncm" maxlength="8" /></FormField>
        <FormField Label="Unidade"><input type="text" @bind="_unit" /></FormField>
        <FormField Label="Categoria">
            <select @bind="_category">
                @foreach (var cat in Enum.GetValues<ProductCategory>())
                {
                    <option value="@cat">@cat</option>
                }
            </select>
        </FormField>
        <FormField Label="Nível Reabastecimento"><input type="number" step="0.01" @bind="_reorderLevel" /></FormField>
        <FormField Label="Estoque alvo (sugestão)"><input type="number" step="0.01" @bind="_targetStock" /></FormField>
    </ChildContent>
    <FooterTemplate>
        <button class="btn" @onclick="() => _showModal = false">Cancelar</button>
        <button class="btn btn-primary" @onclick="SaveProduct">Salvar</button>
    </FooterTemplate>
</Modal>

@code {
    private List<InventoryProductListItem>? _products;
    private bool _isLoading;
    private bool _showModal;
    private string _name = "";
    private string _description = "";
    private string _sku = "";
    private string _barcode = "";
    private string _ncm = "23091000";
    private string _unit = "UN";
    private ProductCategory _category = ProductCategory.Other;
    private decimal _reorderLevel;
    private decimal _targetStock;

    protected override async Task OnInitializedAsync() => await LoadProductsAsync();

    private async Task LoadProductsAsync()
    {
        _isLoading = true;
        var result = await InventoryStore.ListProductsAsync();
        _products = result.IsSuccess ? result.Value.ToList() : new List<InventoryProductListItem>();
        _isLoading = false;
    }

    private void OpenAddModal()
    {
        _name = _description = _sku = _barcode = "";
        _ncm = "23091000";
        _unit = "UN";
        _category = ProductCategory.Other;
        _reorderLevel = 0;
        _targetStock = 0;
        _showModal = true;
    }

    private async Task SaveProduct()
    {
        await InventoryStore.RegisterProductAsync(_name, _description, _sku, _barcode, _unit, _reorderLevel, _category, _ncm, null, 0, null, null, _targetStock);
        _showModal = false;
        await LoadProductsAsync();
    }

    private void GoToDetail(Guid id) => Navigation.NavigateTo($"{AppRoutes.Products}/{id}");
}
