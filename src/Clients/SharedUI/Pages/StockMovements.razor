@page "/stock-movements"
@using Clients.Infrastructure.Crm
@using Inventory.Domain.Entities
@using SharedUI.Components
@using SharedUI.Services
@inject IInventoryStore InventoryStore
@inject IToastService Toast

<div class="header-section">
    <h1>Movimentações de estoque</h1>
    <button class="btn btn-primary" @onclick="OpenAddModal">Registrar movimentação</button>
</div>

<LoadingState IsLoading="_loading" Message="Carregando movimentações...">
    <div class="card p-3">
        @if (!_movements.Any())
        {
            <p class="empty-state">Nenhuma movimentação registrada.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Tipo</th>
                        <th>Produto</th>
                        <th>Quantidade</th>
                        <th>Motivo</th>
                        <th>Lote</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var mov in _movements)
                    {
                        <tr>
                            <td>@mov.Date.LocalDateTime.ToString("g")</td>
                            <td>@DisplayType(mov.Type)</td>
                            <td>@mov.ProductName</td>
                            <td>@mov.Quantity</td>
                            <td>@mov.Reason</td>
                            <td>@(mov.LotNumber ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</LoadingState>

<Modal @bind-IsVisible="_showModal" Title="Registrar movimentação">
    <ChildContent>
        <FormField Label="Produto">
            <select @bind="_selectedProductId" @bind:after="OnProductChanged">
                <option value="@Guid.Empty">Selecione...</option>
                @foreach (var p in _products)
                {
                    <option value="@p.Id">@p.Name (@p.Sku)</option>
                }
            </select>
        </FormField>
        <FormField Label="Lote (quando exigido)">
            <select @bind="_selectedLotId">
                <option value="">—</option>
                @foreach (var lot in _lotsForProduct)
                {
                    <option value="@lot.Id">@lot.LotNumber (saldo @lot.Quantity)</option>
                }
            </select>
        </FormField>
        <FormField Label="Tipo">
            <select @bind="_movementType">
                <option value="@MovementType.In">Entrada</option>
                <option value="@MovementType.Out">Saída</option>
                <option value="@MovementType.Adjustment">Ajuste</option>
            </select>
        </FormField>
        @if (_movementType == MovementType.Adjustment)
        {
            <FormField Label="Direção do ajuste">
                <select @bind="_adjustmentDirection">
                    <option value="@AdjustmentDirection.Increase">Aumento</option>
                    <option value="@AdjustmentDirection.Decrease">Redução</option>
                </select>
            </FormField>
        }
        <FormField Label="Quantidade">
            <input type="number" step="0.01" @bind="_quantity" />
        </FormField>
        <FormField Label="Motivo">
            <input type="text" @bind="_reason" />
        </FormField>
    </ChildContent>
    <FooterTemplate>
        <button class="btn" @onclick="() => _showModal = false">Cancelar</button>
        <button class="btn btn-primary" @onclick="SaveMovement">Registrar</button>
    </FooterTemplate>
</Modal>

@code {
    private List<InventoryStockMovementItem> _movements = [];
    private List<InventoryProductListItem> _products = [];
    private List<InventoryProductLotItem> _lotsForProduct = [];
    private bool _loading = true;
    private bool _showModal;
    private Guid _selectedProductId;
    private Guid? _selectedLotId;
    private MovementType _movementType = MovementType.In;
    private AdjustmentDirection _adjustmentDirection = AdjustmentDirection.Increase;
    private decimal _quantity = 1;
    private string _reason = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
        await LoadMovementsAsync();
    }

    private async Task LoadProductsAsync()
    {
        var result = await InventoryStore.ListProductsAsync();
        _products = result.IsSuccess ? result.Value.ToList() : [];
    }

    private async Task LoadMovementsAsync()
    {
        _loading = true;
        var result = await InventoryStore.ListStockMovementsAsync();
        _movements = result.IsSuccess ? result.Value.ToList() : [];
        _loading = false;
    }

    private async Task OnProductChanged()
    {
        _lotsForProduct = [];
        if (_selectedProductId == Guid.Empty)
        {
            return;
        }

        var detail = await InventoryStore.GetProductByIdAsync(_selectedProductId);
        if (detail.IsSuccess)
        {
            _lotsForProduct = detail.Value.Lots.Where(l => l.IsActive).ToList();
        }
    }

    private void OpenAddModal()
    {
        _selectedProductId = Guid.Empty;
        _selectedLotId = null;
        _movementType = MovementType.In;
        _quantity = 1;
        _reason = string.Empty;
        _lotsForProduct = [];
        _showModal = true;
    }

    private async Task SaveMovement()
    {
        if (_selectedProductId == Guid.Empty)
        {
            Toast.Show("Selecione um produto.", ToastType.Warning);
            return;
        }

        AdjustmentDirection? direction = _movementType == MovementType.Adjustment ? _adjustmentDirection : null;
        var result = await InventoryStore.RegisterStockMovementAsync(
            _selectedProductId,
            _movementType,
            _quantity,
            _reason,
            _selectedLotId,
            direction);

        if (result.IsFailure)
        {
            Toast.Show(result.Error.Message, ToastType.Error);
            return;
        }

        Toast.Show("Movimentação registrada.", ToastType.Success);
        _showModal = false;
        await LoadMovementsAsync();
        await LoadProductsAsync();
    }

    private static string DisplayType(MovementType type) => type switch
    {
        MovementType.In => "Entrada",
        MovementType.Out => "Saída",
        MovementType.Adjustment => "Ajuste",
        _ => type.ToString()
    };
}
