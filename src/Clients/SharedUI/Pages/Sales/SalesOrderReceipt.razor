@page "/sales/orders/{OrderId:guid}/receipt"
@using Microsoft.JSInterop
@using SharedUI.Components
@using Clients.Infrastructure.Http
@using Clients.Infrastructure.Sales
@using SharedUI.Services
@using Clients.Infrastructure.Fiscal
@using OfflineFiscalDocument = Clients.Infrastructure.Fiscal.OfflineFiscalDocument
@using SharedUI.Navigation
@inject ISalesStore SalesStore
@inject FiscalApiService FiscalApi
@inject IFiscalStore FiscalStore
@inject IToastService Toast
@inject IJSRuntime Js

<div class="header-section no-print">
    <h1>Comprovante de venda</h1>
    <button class="btn btn-outline" @onclick="PrintAsync">Imprimir</button>
    @if (_order is not null && string.Equals(_order.Status, "Paid", StringComparison.OrdinalIgnoreCase))
    {
        <button class="btn btn-outline no-print" disabled="_issuingFiscal" @onclick="IssueFiscalAsync">Emitir nota</button>
    }
    <a class="btn btn-primary" href="/sales/pos">Nova venda</a>
</div>

<LoadingState IsLoading="_loading" Message="Carregando comprovante...">
    @if (_order is not null)
    {
        <div class="card print-area">
            <p><strong>Pedido:</strong> @_order.Id</p>
            <p><strong>Status:</strong> @_order.Status · Sync: @_syncState</p>
            <p><strong>Financeiro:</strong> @_order.FinanceIntegrationStatus</p>
            <p><strong>Data:</strong> @(_order.PaidAt?.LocalDateTime.ToString("g") ?? _order.CreatedAt.LocalDateTime.ToString("g"))</p>
            <table class="data-table">
                <thead>
                    <tr><th>Item</th><th>Qtd</th><th>Unit.</th><th>Total</th></tr>
                </thead>
                <tbody>
                    @foreach (var line in _order.Items)
                    {
                        <tr>
                            <td>
                                @line.ProductName
                                @if (line.RemainingQuantity > 0 && string.Equals(line.Kind, "Product", StringComparison.OrdinalIgnoreCase))
                                {
                                    <button type="button" class="btn btn-outline btn-sm no-print" @onclick="() => ReturnItemAsync(line)">
                                        Devolver 1
                                    </button>
                                }
                            </td>
                            <td>@line.Quantity @(line.ReturnedQuantity > 0 ? $"(dev. {line.ReturnedQuantity})" : "")</td>
                            <td>@line.UnitPrice.ToString("C")</td>
                            <td>@((line.Quantity * line.UnitPrice).ToString("C"))</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p><strong>Total:</strong> @_order.TotalAmount.ToString("C")</p>
            @if (_nfceDocs.Any())
            {
                <h4>NFC-e</h4>
                <ul class="payment-list">
                    @foreach (var doc in _nfceDocs)
                    {
                        <li>
                            <strong>@doc.Status</strong>
                            @if (!string.IsNullOrWhiteSpace(doc.AccessKey))
                            {
                                <span class="text-muted"> · Chave @doc.AccessKey</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(doc.QrCodeUrl))
                            {
                                <div class="text-muted small">QR: @doc.QrCodeUrl</div>
                            }
                        </li>
                    }
                </ul>
            }
            <h4>Pagamentos</h4>
            <ul class="payment-list">
                @foreach (var p in _order.Payments)
                {
                    <li>
                        <div>
                            <strong>@p.Method</strong>: @p.Amount.ToString("C")
                            @if (!string.IsNullOrWhiteSpace(p.Nsu))
                            {
                                <span class="text-muted"> · NSU @p.Nsu</span>
                            }
                            @if (p.RemainingRefundable > 0)
                            {
                                <button type="button" class="btn btn-outline btn-sm no-print" @onclick="() => RefundPaymentAsync(p)">
                                    Estornar @p.RemainingRefundable.ToString("C")
                                </button>
                            }
                        </div>
                        @if (p.Refunds.Any())
                        {
                            <ul>
                                @foreach (var r in p.Refunds)
                                {
                                    <li class="text-muted">Estorno: @r.Amount.ToString("C") @(r.RefundNsu is not null ? $"NSU {r.RefundNsu}" : "")</li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ul>
        </div>
    }
</LoadingState>

<style>
    .header-section { display: flex; gap: var(--spacing-sm); align-items: center; margin-bottom: var(--spacing-lg); }
    .data-table { width: 100%; border-collapse: collapse; }
    .data-table th, .data-table td { border: 1px solid var(--color-border); padding: var(--spacing-sm); }
    .payment-list { list-style: none; padding: 0; }
    @@media print {
        .no-print { display: none !important; }
        .print-area { box-shadow: none; border: none; }
    }
</style>

@code {
    [Parameter] public Guid OrderId { get; set; }

    private SalesOrderDetailClientDto? _order;
    private SalesOrderSyncState _syncState;
    private bool _loading = true;
    private bool _issuingFiscal;
    private IReadOnlyList<OfflineFiscalDocument> _nfceDocs = Array.Empty<OfflineFiscalDocument>();

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _syncState = await SalesStore.GetOrderSyncStateAsync(OrderId);
        var result = await SalesStore.GetOrderByIdAsync(OrderId);
        if (result.IsSuccess)
        {
            _order = result.Value;
        }
        else
        {
            Toast.Show(result.Error.Message, ToastType.Error);
        }

        _nfceDocs = await FiscalStore.GetDocumentsByOrderAsync(OrderId);
        var fiscalList = await FiscalApi.ListDocumentsAsync(OrderId);
        if (fiscalList.IsSuccess && fiscalList.Value.Count > 0 && _nfceDocs.Count == 0)
        {
            _nfceDocs = fiscalList.Value.Select(d => new OfflineFiscalDocument
            {
                Id = d.Id,
                OrderId = d.SourceOrderId,
                DocumentType = d.DocumentType,
                Status = d.Status,
                AccessKey = d.AccessKey,
                UpdatedAt = d.CreatedAt,
                AuthorizedAt = d.AuthorizedAt
            }).ToList();
        }

        _loading = false;
    }

    private async Task RefundPaymentAsync(PayOrderPaymentClientDto payment)
    {
        if (!payment.Id.HasValue || payment.Id.Value == Guid.Empty)
        {
            return;
        }

        var refund = await SalesStore.RefundOrderPaymentAsync(OrderId, payment.Id.Value, payment.RemainingRefundable);
        if (refund.IsFailure)
        {
            Toast.Show(refund.Error.Message, ToastType.Error);
            return;
        }

        Toast.Show("Estorno registrado.", ToastType.Success);
        await ReloadAsync();
    }

    private async Task ReturnItemAsync(SalesOrderItemClientDto line)
    {
        if (line.Id == Guid.Empty || line.RemainingQuantity <= 0)
        {
            return;
        }

        var result = await SalesStore.ReturnOrderAsync(OrderId, Guid.NewGuid(), [
            new ReturnOrderLineClientDto { OrderItemId = line.Id, Quantity = 1m }
        ]);
        if (result.IsFailure)
        {
            Toast.Show(result.Error.Message, ToastType.Error);
            return;
        }

        Toast.Show("Devolução registrada.", ToastType.Success);
        await ReloadAsync();
    }

    private async Task PrintAsync() => await Js.InvokeVoidAsync("print");

    private async Task IssueFiscalAsync()
    {
        _issuingFiscal = true;
        var result = await FiscalApi.IssueFromOrderAsync(OrderId);
        _issuingFiscal = false;
        if (result.IsFailure)
        {
            Toast.Show(result.Error.Message, ToastType.Error);
            return;
        }

        Toast.Show("Nota(s) emitida(s).", ToastType.Success);
    }
}
