@page "/sales/cash-register"
@using Clients.Infrastructure.Http
@using Clients.Infrastructure.Sales
@using SharedUI.Services
@inject ISalesStore SalesStore
@inject IToastService Toast
@inject IConnectivityService Connectivity

<div class="header-container">
    <h2>Gerenciamento de Caixa</h2>
    @if (!Connectivity.IsOnline)
    {
        <p class="text-muted">Caixa offline — sincroniza ao reconectar.</p>
    }
</div>

@if (_openRegister != null)
{
    <div class="card status-open">
        <h3>Sessão Ativa</h3>
        <p><strong>Caixa ID:</strong> @_openRegister.Id</p>
        <p><strong>Saldo Inicial:</strong> R$ @_openRegister.OpeningBalance.ToString("N2")</p>
        <p><strong>Saldo Atual (gaveta):</strong> R$ @_openRegister.CurrentBalance.ToString("N2")</p>
        @if (_openRegister.MethodTotals.Any())
        {
            <table class="totals-table">
                <thead>
                    <tr><th>Forma</th><th>Bruto</th><th>Estornado</th><th>Líquido</th></tr>
                </thead>
                <tbody>
                    @foreach (var row in _openRegister.MethodTotals)
                    {
                        <tr>
                            <td>@row.Method</td>
                            <td>R$ @row.Gross.ToString("N2")</td>
                            <td>R$ @row.Refunded.ToString("N2")</td>
                            <td>R$ @row.Net.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <hr />

        <h4>Fechamento de Caixa</h4>
        <div class="form-group">
            <label>Valor real em caixa (para conferência):</label>
            <input type="number" step="0.01" class="form-control" @bind="_actualClosingBalance" />
        </div>
        <button class="btn btn-danger" @onclick="CloseRegister" disabled="@_isLoading">
            @(_isLoading ? "Fechando..." : "Fechar Caixa")
        </button>
    </div>
}
else
{
    <div class="card status-closed">
        <h3>Nenhum Caixa Aberto</h3>
        <div class="form-group">
            <label>Saldo Inicial (Troco):</label>
            <input type="number" step="0.01" class="form-control" @bind="_openingBalance" />
        </div>
        <button class="btn btn-primary" @onclick="OpenRegister" disabled="@_isLoading">
            @(_isLoading ? "Abrindo..." : "Abrir Caixa")
        </button>
    </div>
}

<style>
    .totals-table { width: 100%; border-collapse: collapse; margin-top: var(--spacing-md); }
    .totals-table th, .totals-table td { border: 1px solid var(--color-border); padding: var(--spacing-xs); text-align: left; }
</style>

@code {
    private CashRegisterClientDto? _openRegister;
    private decimal _openingBalance = 100m;
    private decimal _actualClosingBalance;
    private bool _isLoading;

    protected override async Task OnInitializedAsync()
    {
        await RefreshRegisterAsync();
    }

    private async Task RefreshRegisterAsync()
    {
        var result = await SalesStore.GetOpenCashRegisterAsync();
        if (result.IsSuccess)
        {
            _openRegister = result.Value;
            if (_openRegister != null)
            {
                _actualClosingBalance = _openRegister.CurrentBalance;
            }
        }
    }

    private async Task OpenRegister()
    {
        _isLoading = true;
        var result = await SalesStore.OpenCashRegisterAsync(_openingBalance);
        if (result.IsFailure)
        {
            Toast.Show(result.Error.Message, ToastType.Error);
        }
        else
        {
            await RefreshRegisterAsync();
        }

        _isLoading = false;
    }

    private async Task CloseRegister()
    {
        if (_openRegister == null)
        {
            return;
        }

        _isLoading = true;
        var result = await SalesStore.CloseCashRegisterAsync(_openRegister.Id, _actualClosingBalance);
        if (result.IsFailure)
        {
            Toast.Show(result.Error.Message, ToastType.Error);
        }
        else
        {
            _openRegister = null;
        }

        _isLoading = false;
    }
}
