@page "/automations"
@using Clients.Infrastructure.Automations
@using SharedUI.Components
@using SharedUI.Navigation
@using SharedUI.Services
@inject AutomationsApiService AutomationsApi
@inject IConnectivityService Connectivity
@inject IToastService Toast

<div class="header-section">
    <h1 class="mb-0">Automações</h1>
    <p class="text-muted small mb-0">Templates, lembretes (WhatsApp/e-mail) e fila de mensagens. SMS não disponível nesta versão.</p>
</div>

@if (!Connectivity.IsOnline)
{
    <div class="alert alert-warning">Templates e jobs exigem conexão online com a API.</div>
}

<LoadingState IsLoading="_loading" Message="Carregando automações...">
    <div class="card mb-3">
        <h5>Horário comercial</h5>
        @if (_settings is not null)
        {
            <p class="small text-muted mb-2">@_settings.TimeZoneId — @_settings.BusinessStart às @_settings.BusinessEnd</p>
            <p class="small mb-0">Dias: @string.Join(", ", _settings.BusinessDays)</p>
        }
    </div>

    <div class="card mb-3">
        <h5>Templates</h5>
        @if (_templates.Count == 0)
        {
            <p class="text-muted mb-0">Nenhum template cadastrado.</p>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Canal</th>
                        <th>Ativo</th>
                        <th>Corpo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in _templates)
                    {
                        <tr>
                            <td>@t.Code</td>
                            <td>@t.Channel</td>
                            <td>@(t.IsActive ? "Sim" : "Não")</td>
                            <td class="small text-truncate" style="max-width:20rem">@t.Body</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="card mb-3">
        <h5>Campanhas e NPS</h5>
        <p class="small text-muted">Inativos 90 dias (lançamento manual) e NPS pós-atendimento (automático quando campanha ativa).</p>
        <button class="btn btn-sm btn-outline-primary mb-2" @onclick="CreateInactiveCampaignAsync">Criar campanha inativos</button>
        <button class="btn btn-sm btn-outline-secondary mb-2 ms-1" @onclick="CreateNpsCampaignAsync">Criar campanha NPS (ativar)</button>
        @if (_campaigns.Count == 0)
        {
            <p class="text-muted mb-0">Nenhuma campanha cadastrada.</p>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Segmento</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in _campaigns)
                    {
                        <tr>
                            <td>@c.Name</td>
                            <td>@c.SegmentKind</td>
                            <td>@c.Status</td>
                            <td>
                                @if (c.SegmentKind == 1)
                                {
                                    <button class="btn btn-link btn-sm p-0" @onclick="() => LaunchCampaignAsync(c.Id)">Lançar</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        @if (_npsReport is not null)
        {
            <p class="small mb-0 mt-2">NPS (30 dias): @_npsReport.NpsScore — @_npsReport.TotalResponses resposta(s)</p>
        }
    </div>

    <div class="card">
        <h5>Jobs recentes</h5>
        @if (_jobs.Count == 0)
        {
            <p class="text-muted mb-0">Nenhum job na fila.</p>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Template</th>
                        <th>Status</th>
                        <th>Tentativas</th>
                        <th>Último erro</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var j in _jobs)
                    {
                        <tr>
                            <td>@j.TemplateCode</td>
                            <td>@j.Status</td>
                            <td>@j.AttemptCount (@j.AttemptLogs.Count log)</td>
                            <td class="small">@(j.LastError ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</LoadingState>

@code {
    private bool _loading;
    private AutomationsSettingsClientDto? _settings;
    private List<MessageTemplateClientDto> _templates = new();
    private List<MessageJobClientDto> _jobs = new();
    private List<CampaignClientDto> _campaigns = new();
    private NpsReportClientDto? _npsReport;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!Connectivity.IsOnline)
        {
            return;
        }

        _loading = true;
        try
        {
            var settings = await AutomationsApi.GetSettingsAsync();
            if (settings.IsSuccess)
            {
                _settings = settings.Value;
            }

            var templates = await AutomationsApi.ListTemplatesAsync();
            if (templates.IsSuccess)
            {
                _templates = templates.Value.ToList();
            }
            else
            {
                Toast.Show(templates.Error.Message, ToastType.Warning);
            }

            var jobs = await AutomationsApi.ListJobsAsync();
            if (jobs.IsSuccess)
            {
                _jobs = jobs.Value.ToList();
            }
            else
            {
                Toast.Show(jobs.Error.Message, ToastType.Warning);
            }

            var campaigns = await AutomationsApi.ListCampaignsAsync();
            if (campaigns.IsSuccess)
            {
                _campaigns = campaigns.Value.ToList();
            }

            var nps = await AutomationsApi.GetNpsReportAsync();
            if (nps.IsSuccess)
            {
                _npsReport = nps.Value;
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateInactiveCampaignAsync()
    {
        var result = await AutomationsApi.CreateCampaignAsync(new CreateCampaignClientRequest
        {
            Name = "Reativação inativos",
            SegmentKind = 1
        });
        if (result.IsSuccess)
        {
            Toast.Show("Campanha criada.", ToastType.Success);
            await LoadAsync();
        }
        else
        {
            Toast.Show(result.Error.Message, ToastType.Error);
        }
    }

    private async Task CreateNpsCampaignAsync()
    {
        var result = await AutomationsApi.CreateCampaignAsync(new CreateCampaignClientRequest
        {
            Name = "NPS pós-atendimento",
            SegmentKind = 2
        });
        if (result.IsFailure)
        {
            Toast.Show(result.Error.Message, ToastType.Error);
            return;
        }

        Toast.Show("Campanha NPS criada (rascunho). Ative via API se necessário.", ToastType.Success);
        await LoadAsync();
    }

    private async Task LaunchCampaignAsync(Guid campaignId)
    {
        var result = await AutomationsApi.LaunchCampaignAsync(campaignId);
        if (result.IsSuccess)
        {
            Toast.Show($"Lançamento: {result.Value.EnqueuedCount} job(s) enfileirado(s).", ToastType.Success);
            await LoadAsync();
        }
        else
        {
            Toast.Show(result.Error.Message, ToastType.Error);
        }
    }
}
