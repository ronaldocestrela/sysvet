@page "/pets/{petId:guid}/timeline"
@inject TutorPortalApiService Api
@inject IToastService Toast

<h1 class="h5 mb-3">Linha do tempo</h1>

<LoadingState IsLoading="_loading">
    @if (_items.Count == 0 && !_loading)
    {
        <p class="text-muted">Nenhum atendimento registrado.</p>
    }
    else
    {
        <ul class="list-group">
            @foreach (var item in _items)
            {
                <li class="list-group-item">
                    <strong>@item.Title</strong>
                    <div class="small text-muted">
                        @item.OccurredAt.LocalDateTime.ToString("g") · @FormatSource(item.SourceType) · @item.Status
                    </div>
                </li>
            }
        </ul>
    }
</LoadingState>

<p class="mt-3"><a href="@($"/pets/{PetId}")">← Voltar ao pet</a></p>

@code {
    [Parameter] public Guid PetId { get; set; }

    private List<TutorPetTimelineItemDto> _items = [];
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        var result = await Api.GetTimelineAsync(PetId);
        if (result.IsFailure)
        {
            Toast.Show(result.Error.Message, ToastType.Error);
            _items = [];
        }
        else
        {
            _items = result.Value ?? [];
        }

        _loading = false;
    }

    private static string FormatSource(string sourceType) =>
        sourceType switch
        {
            "Grooming" => "Estética",
            "Appointment" => "Consulta",
            _ => sourceType
        };
}
