@page "/pets/{petId:guid}/vaccines"
@inject TutorPortalApiService Api
@inject IToastService Toast

<h1 class="h5 mb-3">Carteira de vacinação</h1>

<LoadingState IsLoading="_loading" Message="Carregando carteira...">
    @if (_card is not null)
    {
        <VaccinationCardDisplay
            PetName="@_card.PetName"
            Species="@_card.Species"
            Breed="@_card.Breed"
            BirthDate="@_card.BirthDate"
            TutorName="@_card.TutorName"
            AppliedDoses="@_applied"
            SuggestedDoses="@_suggested" />
    }
</LoadingState>

<p class="mt-3"><a href="@($"/pets/{PetId}")">← Voltar ao pet</a></p>

@code {
    [Parameter] public Guid PetId { get; set; }

    private TutorVaccinationCardDto? _card;
    private IReadOnlyList<VaccinationCardDisplay.VaccinationCardDoseRow> _applied = Array.Empty<VaccinationCardDisplay.VaccinationCardDoseRow>();
    private IReadOnlyList<VaccinationCardDisplay.VaccinationCardSuggestedRow> _suggested = Array.Empty<VaccinationCardDisplay.VaccinationCardSuggestedRow>();
    private bool _loading = true;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await Api.GetVaccinationCardAsync(PetId);
        if (result.IsFailure)
        {
            Toast.Show(result.Error.Message, ToastType.Error);
            _card = null;
        }
        else
        {
            _card = result.Value;
            _applied = _card.AppliedDoses.Select(d => new VaccinationCardDisplay.VaccinationCardDoseRow
            {
                Name = d.Name,
                BatchNumber = d.BatchNumber,
                AppliedAt = d.AppliedAt,
                NextDueDate = d.NextDueDate
            }).ToList();
            _suggested = _card.SuggestedDoses.Select(s => new VaccinationCardDisplay.VaccinationCardSuggestedRow
            {
                ProtocolName = s.ProtocolName,
                Label = s.Label
            }).ToList();
        }

        _loading = false;
    }
}
