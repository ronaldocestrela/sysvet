@page "/"
@inject TutorPortalApiService Api

@if (_loading)
{
    <LoadingState />
}
else if (_me is not null)
{
    <h1 class="h4">Olá, @_me.Name</h1>
    <p class="text-muted">@_me.Email</p>
    <h2 class="h6 mt-4">Seus pets</h2>
    @if (_me.Pets.Count == 0)
    {
        <p class="text-muted">Nenhum pet vinculado.</p>
    }
    else
    {
        <ul class="list-group">
            @foreach (var pet in _me.Pets)
            {
                <li class="list-group-item">@pet.Name</li>
            }
        </ul>
    }
}

@code {
    private TutorPortalMeDto? _me;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetMeAsync();
        if (result.IsSuccess)
        {
            _me = result.Value;
        }

        _loading = false;
    }
}
