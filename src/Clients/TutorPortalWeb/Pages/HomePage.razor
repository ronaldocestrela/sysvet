@page "/"
@using Microsoft.JSInterop
@inject TutorPortalApiService Api
@inject IJSRuntime Js
@implements IAsyncDisposable

@if (_loading)
{
    <LoadingState />
}
else if (_me is not null)
{
    <h1 class="h4">Olá, @_me.Name</h1>
    <p class="text-muted">@_me.Email</p>
    <h2 class="h6 mt-4">Seus pets</h2>
    @if (_me.Pets.Count == 0)
    {
        <p class="text-muted">Nenhum pet vinculado.</p>
    }
    else
    {
        <ul class="list-group">
            @foreach (var pet in _me.Pets)
            {
                <li class="list-group-item">
                    <a href="@($"/pets/{pet.Id}")" class="text-decoration-none">@pet.Name</a>
                </li>
            }
        </ul>
    }
}

@code {
    private TutorPortalMeDto? _me;
    private bool _loading = true;

    private DotNetObjectReference<HomePage>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetMeAsync();
        if (result.IsSuccess)
        {
            _me = result.Value;
            await TryRegisterPushAsync();
        }

        _loading = false;
    }

    private async Task TryRegisterPushAsync()
    {
        var vapid = await Api.GetVapidPublicKeyAsync();
        if (vapid.IsFailure || string.IsNullOrWhiteSpace(vapid.Value))
        {
            return;
        }

        _dotNetRef = DotNetObjectReference.Create(this);
        await Js.InvokeVoidAsync("tutorPortalPush.register", vapid.Value, _dotNetRef);
    }

    [JSInvokable]
    public async Task OnPushSubscriptionAsync(string endpoint, string p256dh, string auth)
    {
        await Api.SubscribePushAsync(new TutorPushSubscribeRequest
        {
            Endpoint = endpoint,
            P256dh = p256dh,
            Auth = auth,
            UserAgent = null
        });
    }

    public ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        return ValueTask.CompletedTask;
    }
}
