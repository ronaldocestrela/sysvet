<Router AppAssembly="@typeof(Main).Assembly" AdditionalAssemblies="new[] { typeof(SharedUI.Layout.MainLayout).Assembly }" NotFoundPage="typeof(SharedUI.Pages.NotFound)">
	<Found Context="routeData">
		<RouteView RouteData="@routeData" DefaultLayout="@typeof(SharedUI.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
	</Found>
</Router>
