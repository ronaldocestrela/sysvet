@using Core.Domain.Entitlements

<div>
    <h3 class="h5">Feature flags</h3>
    @if (_busy)
    {
        <p>Aplicando…</p>
    }
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-info">@_message</div>
    }
    <div class="d-flex flex-wrap gap-2">
        @foreach (var module in _modules)
        {
            <button class="btn btn-sm btn-outline-danger" disabled="@_busy"
                    @onclick="() => DisableAsync(module)">
                Desabilitar @module
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public Guid TenantId { get; set; }
    [Inject] public IPlatformAdminApi PlatformApi { get; set; } = default!;

    private bool _busy;
    private string? _message;
    private readonly CommercialModule[] _modules =
    [
        CommercialModule.Veterinary,
        CommercialModule.Inventory,
        CommercialModule.Sales
    ];

    private async Task DisableAsync(CommercialModule module)
    {
        _busy = true;
        _message = null;
        var result = await PlatformApi.SetFeatureFlagAsync(TenantId, module, PlatformFeatureFlagState.Disabled);
        _busy = false;
        _message = result.IsSuccess ? $"Flag {module} desabilitada." : result.Error.Message;
    }
}
