@page "/metrics"
@inject IPlatformAdminApi PlatformApi
@inject IPlatformAuthState AuthState

<h1>Métricas SaaS</h1>

@if (!AuthState.IsSuperAdmin)
{
    <p class="text-danger">Acesso negado.</p>
}
else
{
    <div class="row g-2 align-items-end mb-4">
        <div class="col-auto">
            <label class="form-label">Ano</label>
            <input type="number" class="form-control" @bind="_year" min="2000" max="9999" />
        </div>
        <div class="col-auto">
            <label class="form-label">Mês</label>
            <input type="number" class="form-control" @bind="_month" min="1" max="12" />
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="LoadAsync">Atualizar</button>
        </div>
    </div>

    @if (_error is not null)
    {
        <p class="text-danger">@_error</p>
    }
    else if (_metrics is not null)
    {
        <div class="row g-3 mb-4">
            <div class="col-md-3"><div class="card p-3"><div class="text-muted small">MRR faturado</div><strong>@Format(_metrics.BilledMrr)</strong></div></div>
            <div class="col-md-3"><div class="card p-3"><div class="text-muted small">MRR contratado</div><strong>@Format(_metrics.ContractedMrr)</strong></div></div>
            <div class="col-md-3"><div class="card p-3"><div class="text-muted small">ARR</div><strong>@Format(_metrics.Arr)</strong></div></div>
            <div class="col-md-3"><div class="card p-3"><div class="text-muted small">Fluxo líquido</div><strong>@Format(_metrics.NetCashFlow)</strong></div></div>
            <div class="col-md-3"><div class="card p-3"><div class="text-muted small">Churn (logos)</div><strong>@(_metrics.LogoChurnRate.ToString("P2"))</strong></div></div>
            <div class="col-md-3"><div class="card p-3"><div class="text-muted small">LTV</div><strong>@FormatNullable(_metrics.Ltv)</strong></div></div>
            <div class="col-md-3"><div class="card p-3"><div class="text-muted small">CAC</div><strong>@FormatNullable(_metrics.Cac)</strong></div></div>
            <div class="col-md-3"><div class="card p-3"><div class="text-muted small">Gasto aquisição</div><strong>@Format(_metrics.AcquisitionSpend)</strong></div></div>
        </div>

        <h2 class="h5">Inadimplência</h2>
        <table class="table table-sm">
            <thead><tr><th>Tenant</th><th>Valor em aberto</th><th>Standing</th><th>Past due desde</th></tr></thead>
            <tbody>
                @foreach (var row in _metrics.Delinquency)
                {
                    <tr>
                        <td>@row.DisplayName</td>
                        <td>@Format(row.OutstandingAmount)</td>
                        <td>@row.BillingStanding</td>
                        <td>@(row.PastDueSince?.LocalDateTime.ToString("g") ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>

        <h2 class="h5 mt-4">Lançar gasto de aquisição</h2>
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Canal</label>
                <input class="form-control" @bind="_spendChannel" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Valor (R$)</label>
                <input type="number" step="0.01" class="form-control" @bind="_spendAmount" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Nota</label>
                <input class="form-control" @bind="_spendNote" />
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-primary" @onclick="SaveSpendAsync">Salvar</button>
            </div>
        </div>
    }
}

@code {
    private int _year = DateTime.UtcNow.Year;
    private int _month = DateTime.UtcNow.Month;
    private PlatformSaasMetricsDto? _metrics;
    private string? _error;
    private string _spendChannel = "ads";
    private decimal _spendAmount;
    private string? _spendNote;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState.IsSuperAdmin)
        {
            await LoadAsync();
        }
    }

    internal async Task LoadAsync()
    {
        _error = null;
        var result = await PlatformApi.GetSaasMetricsAsync(_year, _month);
        if (result.IsFailure)
        {
            _error = result.Error?.Message ?? "Falha ao carregar métricas.";
            _metrics = null;
            return;
        }

        _metrics = result.Value;
    }

    internal async Task SaveSpendAsync()
    {
        var result = await PlatformApi.UpsertAcquisitionSpendAsync(new PlatformUpsertAcquisitionSpendRequest(
            _year,
            _month,
            _spendChannel,
            _spendAmount,
            _spendNote));

        if (result.IsFailure)
        {
            _error = result.Error?.Message ?? "Falha ao salvar gasto.";
            return;
        }

        await LoadAsync();
    }

    private static string Format(decimal value) => value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));

    private static string FormatNullable(decimal? value) => value is null ? "—" : Format(value.Value);
}
