@page "/servicos"

<h1 class="h3 mb-3">Serviços</h1>
@if (Site.Services.Count == 0)
{
    <p class="text-muted">Nenhum serviço publicado.</p>
}
else
{
    @foreach (var service in Site.Services)
    {
        <article class="mb-3 border-bottom pb-2">
            <h2 class="h5 mb-1">@service.Name</h2>
            @if (!string.IsNullOrWhiteSpace(service.Description))
            {
                <p>@service.Description</p>
            }
            <small class="text-muted">
                @if (service.DurationMinutes is int minutes)
                {
                    <span>@minutes min</span>
                }
                @if (service.Price is decimal price)
                {
                    <span class="ms-2">R$ @price.ToString("N2")</span>
                }
            </small>
        </article>
    }
}

@code {
    [CascadingParameter]
    public PublicClinicSiteClientDto Site { get; set; } = null!;
}
