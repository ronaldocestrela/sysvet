@page "/loja/produto/{OfferId:guid}"
@inject SlugContext SlugContext
@inject PublicStoreApiService StoreApi
@inject NavigationManager Navigation

@if (_product is null)
{
    <p>Produto não encontrado.</p>
}
else
{
    <h1>@_product.ProductName</h1>
    <p class="fs-4 fw-semibold">R$ @_product.SalePrice.ToString("N2")</p>
    <p>Estoque disponível: @_product.AvailableQuantity.ToString("N0")</p>
    @if (_product.IsAvailable)
    {
        <a class="btn btn-success" href="@($"loja/checkout/{OfferId}")">Comprar — retirada na clínica</a>
    }
}

@code {
    [Parameter] public Guid OfferId { get; set; }

    private PublicStoreProductClientDto? _product;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(SlugContext.CurrentSlug))
        {
            return;
        }

        _product = await StoreApi.GetProductAsync(SlugContext.CurrentSlug, OfferId);
    }
}
