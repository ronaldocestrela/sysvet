@page "/equipe"

<h1 class="h3 mb-3">Equipe</h1>
@if (Site.Team.Count == 0)
{
    <p class="text-muted">Equipe em atualização.</p>
}
else
{
    <div class="row g-3">
        @foreach (var member in Site.Team)
        {
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h5">@member.Name</h2>
                        <p class="text-muted mb-1">@member.RoleTitle</p>
                        @if (!string.IsNullOrWhiteSpace(member.Bio))
                        {
                            <p class="mb-0">@member.Bio</p>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [CascadingParameter]
    public PublicClinicSiteClientDto Site { get; set; } = null!;
}
