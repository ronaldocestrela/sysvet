{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "ConnectionStringName": "DefaultConnection"
  },
  "TenancySettings": {
    "DefaultSchema": "dbo"
  },
  "JwtSettings": {
    "Issuer": "sysvet-api",
    "Audience": "sysvet-clients",
    "ExpiryMinutes": 60
  }
}
