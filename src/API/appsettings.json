{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "O",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "ConnectionStringName": "DefaultConnection"
  },
  "ClinicSite": {
    "BaseDomain": "vetnexus.app"
  },
  "TenancySettings": {
    "DefaultSchema": "dbo",
    "SingleTenantId": "11111111-1111-1111-1111-111111111111"
  },
  "Automations": {
    "Provider": "Fake",
    "PollIntervalSeconds": 2,
    "BatchSize": 20,
    "DefaultMaxAttempts": 5,
    "ReminderScanIntervalMinutes": 15,
    "TimeZoneId": "America/Sao_Paulo",
    "BusinessHours": {
      "Start": "08:00",
      "End": "18:00",
      "Days": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
    },
    "Smtp": {
      "Host": "",
      "Port": 587,
      "User": "",
      "Password": "",
      "From": "",
      "EnableSsl": true
    },
    "Evolution": {
      "BaseUrl": "",
      "ApiKey": "",
      "Instance": ""
    }
  },
  "JwtSettings": {
    "Issuer": "sysvet-api",
    "Audience": "sysvet-clients",
    "ExpiryMinutes": 60,
    "RefreshExpiryDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7252",
      "http://localhost:5259"
    ]
  }
}
