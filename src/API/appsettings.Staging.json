{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:YOUR_STAGING_SERVER.database.windows.net,1433;Initial Catalog=SysVet_Staging;Persist Security Info=False;User ID=sysvetadmin;Password=YOUR_PASSWORD;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "JwtSettings": {
    "Issuer": "SysVet_Staging",
    "Audience": "SysVet_Clients",
    "SecretKey": "REPLACE_THIS_WITH_A_SECURE_KEY_IN_STAGING"
  }
}
