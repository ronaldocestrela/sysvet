{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SqlServer",
    "ConnectionStringName": "DefaultConnection"
  },
  "Cache": {
    "Provider": "Redis"
  },
  "TenancySettings": {
    "DefaultSchema": "dbo"
  },
  "JwtSettings": {
    "Issuer": "SysVet_Staging",
    "Audience": "SysVet_Clients",
    "ExpiryMinutes": 60
  }
}
