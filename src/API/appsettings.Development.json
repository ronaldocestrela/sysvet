{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=sysvet.db"
  },
  "JwtSettings": {
    "Secret": "dev-only-secret-key-min-16-chars",
    "Issuer": "sysvet-api",
    "Audience": "sysvet-clients",
    "ExpiryMinutes": 60,
    "RefreshExpiryDays": 7
  },
  "Sales": {
    "PaymentTerminalProvider": "Simulator"
  },
  "BlobStorage": {
    "Provider": "Local",
    "LocalRootPath": "App_Data/blobs"
  },
  "Fiscal": {
    "Provider": "Fake",
    "CertificateEncryptionKey": "dev-fiscal-cert-key-min-32-chars!!"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7252",
      "http://localhost:5259",
      "https://localhost:7262",
      "http://localhost:5260"
    ]
  }
}
