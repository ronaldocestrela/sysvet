sequenceDiagram
    participant Pos as PosTerminal
    participant Store as OfflineSalesStore
    participant Sqlite as OfflineDbContext
    participant Worker as SyncBackgroundWorker
    participant Api as PushSyncBatch
    participant Pay as PayOrderCommand

    Pos->>Store: PayOrder local
    Store->>Sqlite: Order Paid plus lot debit
    Store->>Sqlite: Outbox CreateOrder then PayOrder
    Store->>Worker: RequestSync
    Worker->>Api: FIFO push
    Api->>Pay: Create then Pay
    Pay->>Pay: ConsumeStockForSaleRequest
    alt stock ok
        Pay-->>Worker: ProcessedIds
    else insufficient
        Pay-->>Worker: permanent failure
        Worker->>Sqlite: Outbox.Error dead-letter
    end
